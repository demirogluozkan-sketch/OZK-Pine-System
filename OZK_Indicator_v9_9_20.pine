//@version=6
indicator("OZK Indicator v9.9.20", shorttitle="OZK IND 9.9.20", overlay=true, max_labels_count=500)

//====================================================
// COMPAT CONSTANTS
//====================================================
DIR_BOTH = "Both"
DIR_LONG_ONLY = "Long Only"
DIR_SHORT_ONLY = "Short Only"

MOTOR_AT = "AT"
MOTOR_GC = "GC"
MOTOR_ST = "ST"
MOTOR_EMA = "EMA"
MOTOR_ATEMA = "AT-EMA"
MOTOR_GCEMA = "GC-EMA"
MOTOR_STEMA = "ST-EMA"

//====================================================
// COMMON REASON CODES
//====================================================
MIX_EXIT_SOURCE_LABEL       = "HIBRIT MIX"
MIX_DETAIL_EMA_OK_AT_FAIL   = "EMA_OK_AT_FAIL"
MIX_DETAIL_AT_OK_EMA_FAIL   = "AT_OK_EMA_FAIL"
MIX_DETAIL_EMA_AT_FAIL      = "EMA_AT_FAIL"
MIX_DETAIL_EMA_OK_GC_FAIL   = "EMA_OK_GC_FAIL"
MIX_DETAIL_GC_OK_EMA_FAIL   = "GC_OK_EMA_FAIL"
MIX_DETAIL_EMA_GC_FAIL      = "EMA_GC_FAIL"
MIX_DETAIL_EMA_OK_ST_FAIL   = "EMA_OK_ST_FAIL"
MIX_DETAIL_ST_OK_EMA_FAIL   = "ST_OK_EMA_FAIL"
MIX_DETAIL_EMA_ST_FAIL      = "EMA_ST_FAIL"
MIX_DETAIL_EMA_OK_ATEMA_FAIL = "EMA_OK_ATEMA_FAIL"
MIX_DETAIL_ATEMA_OK_EMA_FAIL = "ATEMA_OK_EMA_FAIL"
MIX_DETAIL_EMA_ATEMA_FAIL    = "EMA_ATEMA_FAIL"
MIX_DETAIL_EMA_OK_GCEMA_FAIL = "EMA_OK_GCEMA_FAIL"
MIX_DETAIL_GCEMA_OK_EMA_FAIL = "GCEMA_OK_EMA_FAIL"
MIX_DETAIL_EMA_GCEMA_FAIL    = "EMA_GCEMA_FAIL"
MIX_DETAIL_EMA_OK_EMA_FAIL  = "EMA_OK_EMA_FAIL"
MIX_DETAIL_EMA_MOTOR_OK_FAIL = "EMA_MOTOR_OK_FAIL"
MIX_DETAIL_EMA_FAIL         = "EMA_FAIL"
MIX_DETAIL_OPP_PERSIST_WAIT = "OPP_PERSIST_WAIT"

//====================================================
// INPUTS
//====================================================
regime_group  = "1. Hibrit Rejim"
engine_group  = "2. Engine / Motor"
filter_group  = "3. Filters"
continuation_group = "4A. Devam / Bekleme"
display_group = "5. Display"
switch_group  = "5A. Switch Board (Grafik Gosterge Ac/Kapat)"
backtest_group = "6. Backtest Tarih Araligi"
alert_group    = "6A. Canli Alarm (4 Ayri TV Alarmi)"

use_regime_persistence = input.bool(false, "Hibrit Kalicilik Sarti", group=regime_group)
regime_persistence_bars = input.int(2, "Hibrit Kalicilik Bar Sayisi", minval=1, group=regime_group)

motor_choice = input.string(MOTOR_AT, "Motor", options=[MOTOR_AT, MOTOR_GC, MOTOR_ST, MOTOR_EMA, MOTOR_ATEMA, MOTOR_GCEMA, MOTOR_STEMA], group=engine_group)
using_at   = motor_choice == MOTOR_AT
using_gc   = motor_choice == MOTOR_GC
using_st   = motor_choice == MOTOR_ST
using_ema  = motor_choice == MOTOR_EMA
using_atema = motor_choice == MOTOR_ATEMA
using_gcema = motor_choice == MOTOR_GCEMA
using_stema = motor_choice == MOTOR_STEMA
engine_label = using_at ? "AT" : using_gc ? "GC" : using_st ? "ST" : using_ema ? "EMA" : using_atema ? "AT-EMA" : "GC-EMA"
engine_mode  = engine_label + " ANA"

trade_direction = input.string(DIR_BOTH, "Trade Direction", options=[DIR_BOTH, DIR_LONG_ONLY, DIR_SHORT_ONLY], group=engine_group)
allow_long_entries  = trade_direction != DIR_SHORT_ONLY
allow_short_entries = trade_direction != DIR_LONG_ONLY

at_len           = input.int(14, "AT Periyot", minval=1, group=engine_group)
at_mult          = input.float(3.0, "AT Katsayi", step=0.1, minval=0.1, group=engine_group)
at_src           = input.source(close, "AT Src", group=engine_group)
at_no_volume_mode = true

gc_len           = input.int(200, "GC Periyot", minval=2, group=engine_group)

use_mtf_filter  = input.bool(false, "Use MTF EMA Filter", group=filter_group)
mtf_tf          = input.timeframe("240", "MTF Timeframe", group=filter_group)
mtf_ema_len     = input.int(200, "MTF EMA Length", minval=1, group=filter_group)
ema_len         = input.int(200, "EMA200 Length", minval=1, group=filter_group)

use_rsi_filter        = input.bool(false, "RSI Filter", group=filter_group)
rsi_confirm_bars      = input.int(1, "RSI Confirm Bars", minval=1, maxval=5, group=filter_group)
rsi_filter_len        = 14
rsi_long_min          = 50.0
rsi_short_max         = 50.0
use_adx_filter        = input.bool(false, "ADX Filter", group=filter_group)
adx_len               = input.int(14, "ADX Length", minval=1, group=filter_group)
adx_min               = input.float(20.0, "ADX Min", minval=1.0, step=0.5, group=filter_group)

st_factor       = input.float(3.0, "ST Factor", minval=0.1, step=0.1, group=engine_group)
st_atr_len      = input.int(10, "ST ATR Length", minval=1, group=engine_group)

show_gchannel_dashboard_row = false
use_secondary_continuation = false
max_setup_age_input        = 0
entry_cooldown_bars        = 0

use_backtest_window       = input.bool(false, "Use Backtest Window", group=backtest_group)
backtest_start_time       = input.time(timestamp("2024-01-01T00:00:00"), "Backtest Start", group=backtest_group)
backtest_end_time         = input.time(timestamp("2099-12-31T23:59:59"), "Backtest End", group=backtest_group)

live_alert_mode_note = input.string("TV_4_AYRI_ALARM", "Canli Alarm Modeli (sabit not)", group=alert_group, tooltip="Canli emir icin TradingView'de 4 ayri alarm kur. Osmanli JSON mesajlarini TradingView alarm penceresindeki Mesaj kutusuna yapistir.")
live_alert_mode = "TV_4_AYRI_ALARM"

safe_motor_flip_exit  = true

show_dashboard      = input.bool(false, "Show Dashboard", group=display_group, inline="dash1")
dashboard_y_raw     = input.string("top", "Position Y (top/middle/bottom)", group=display_group, inline="dash1")
dashboard_x_raw     = input.string("right", "X (left/center/right)", group=display_group, inline="dash1")
dashboard_size_raw  = input.string("Normal", "Dashboard Size (Tiny/Small/Normal/Large)", group=display_group)
dashboard_y         = dashboard_y_raw == "middle" ? "middle" : dashboard_y_raw == "bottom" ? "bottom" : "top"
dashboard_x         = dashboard_x_raw == "left" ? "left" : dashboard_x_raw == "center" ? "center" : "right"
dashboard_size      = dashboard_size_raw == "Tiny" ? "Tiny" : dashboard_size_raw == "Small" ? "Small" : dashboard_size_raw == "Large" ? "Large" : "Normal"
show_shapes         = input.bool(true, "Show Signal Shapes", group=display_group, inline="sig1")
indicator_visual_mode_raw = input.string("STRATEJI_ILE_AYNI", "Indicator Visual Mode (STRATEJI_ILE_AYNI/IND_DEBUG_ETIKET/KAPALI)", group=display_group)
indicator_visual_mode = indicator_visual_mode_raw == "IND_DEBUG_ETIKET" ? "IND_DEBUG_ETIKET" : indicator_visual_mode_raw == "KAPALI" ? "KAPALI" : "STRATEJI_ILE_AYNI"
final_marker_size_raw = input.string("Large", "Indicator Marker Size (Debug) (Small/Normal/Large)", group=display_group, inline="sig1")
final_marker_size_input = final_marker_size_raw == "Small" ? "Small" : final_marker_size_raw == "Normal" ? "Normal" : "Large"
show_exit_shapes    = input.bool(true, "Show Exit Markers", group=display_group)
show_filter_boxes   = input.bool(false, "Show Filter Zones", group=display_group)

visual_mode_same   = indicator_visual_mode == "STRATEJI_ILE_AYNI"
visual_mode_debug  = indicator_visual_mode == "IND_DEBUG_ETIKET"
visual_mode_off    = indicator_visual_mode == "KAPALI"

marker_size_small  = final_marker_size_input == "Small"
marker_size_normal = final_marker_size_input == "Normal"
marker_size_large  = final_marker_size_input == "Large"

show_regime_ema_plot = input.bool(true, "EMA200", group=switch_group, inline="sw1")
show_supertrend_plot = input.bool(false, "SuperTrend", group=switch_group, inline="sw1")
show_mtf_ema_plot    = input.bool(false, "MTF EMA", group=switch_group, inline="sw2")
show_motor_plot      = input.bool(true, "Unified Motor", group=switch_group, inline="sw4")
show_at_raw_plot     = input.bool(false, "AT", group=switch_group, inline="sw4")
show_gc_raw_plot     = input.bool(false, "GC", group=switch_group, inline="sw4")

//====================================================
// HELPERS
//====================================================
cell_text_size(sel) => sel == "Tiny" ? 8 : sel == "Small" ? 10 : sel == "Large" ? 14 : 12
status3(_long_ok, _short_ok) => _long_ok ? "LONG" : _short_ok ? "SHORT" : "NEUTRAL"
status_bg(_long_ok, _short_ok) => _long_ok ? color.rgb(20, 115, 60) : _short_ok ? color.rgb(150, 35, 35) : color.rgb(160, 110, 20)
motor_dash_text(_label, _active, _long_ok, _short_ok) => (_active ? "AKTIF / " : "") + _label + " / " + status3(_long_ok, _short_ok)
motor_dash_bg(_active, _long_ok, _short_ok) => _active ? (_long_ok ? color.rgb(20, 140, 95) : _short_ok ? color.rgb(170, 45, 45) : color.rgb(170, 130, 30)) : status_bg(_long_ok, _short_ok)
pending_text(_pl, _ps, _bl, _bs) => _pl ? "LONG " + str.tostring(_bl) : _ps ? "SHORT " + str.tostring(_bs) : "YOK"
setup_age_text(_pl, _ps, _al, _as) => _pl and not na(_al) ? "LONG A" + str.tostring(_al) : _ps and not na(_as) ? "SHORT A" + str.tostring(_as) : "YOK"
block_bg(_reason) => _reason == "KALICILIK" ? color.rgb(160, 110, 20) : _reason == "REJIM" ? color.rgb(160, 110, 20) : _reason == "FILTRE" ? color.rgb(120, 80, 150) : _reason == "RECLAIM" ? color.rgb(180, 90, 20) : _reason == "RE-ENTRY" ? color.rgb(150, 35, 35) : _reason == "COOLDOWN" ? color.rgb(150, 35, 35) : _reason == "STATE" ? color.rgb(20, 100, 120) : color.rgb(70, 70, 70)
audit_code(_long_evt, _short_evt) => _long_evt ? "L" : _short_evt ? "S" : "-"
audit_flag(_cond) => _cond ? "1" : "0"
audit_status_bg(_long_evt, _short_evt) => _long_evt ? color.rgb(20, 115, 60) : _short_evt ? color.rgb(150, 35, 35) : color.rgb(70, 70, 70)
mix_detail_bg(_detail) => (_detail == MIX_DETAIL_EMA_OK_AT_FAIL or _detail == MIX_DETAIL_EMA_OK_GC_FAIL or _detail == MIX_DETAIL_EMA_OK_ST_FAIL or _detail == MIX_DETAIL_EMA_OK_EMA_FAIL) ? color.rgb(180, 120, 30) : (_detail == MIX_DETAIL_AT_OK_EMA_FAIL or _detail == MIX_DETAIL_GC_OK_EMA_FAIL or _detail == MIX_DETAIL_ST_OK_EMA_FAIL or _detail == MIX_DETAIL_EMA_MOTOR_OK_FAIL) ? color.rgb(160, 100, 20) : _detail == MIX_DETAIL_OPP_PERSIST_WAIT ? color.rgb(40, 80, 140) : (_detail == MIX_DETAIL_EMA_AT_FAIL or _detail == MIX_DETAIL_EMA_GC_FAIL or _detail == MIX_DETAIL_EMA_ST_FAIL or _detail == MIX_DETAIL_EMA_FAIL) ? color.rgb(120, 70, 20) : color.rgb(70, 70, 70)

var string last_exit_reason = "NONE"
var string last_entry_source = "YOK"
var bool long_tp_wait_reset = false
var bool short_tp_wait_reset = false
var bool long_reentry_lock = false
var bool short_reentry_lock = false
var float long_reentry_level = na
var float short_reentry_level = na
var int last_exit_bar = na
var bool long_flip_reclaim_armed = false
var bool short_flip_reclaim_armed = false
var float last_long_exit_price = na
var float last_short_exit_price = na
var string last_block_reason = "YOK"
var color last_exit_bg = color.rgb(70, 70, 70)
var string last_mix_detail = "YOK"

STATE_FLAT = 0
STATE_LONG = 1
STATE_SHORT = -1

var int trade_state = STATE_FLAT
var int long_setup_age = na
var int short_setup_age = na
setup_memory_after_bars = max_setup_age_input

var int audit_regime_blocks = 0
var int audit_regime_persist_blocks = 0
var int audit_filter_blocks = 0
var int audit_reentry_blocks = 0
var int audit_reclaim_blocks = 0
var int audit_cooldown_blocks = 0
var int audit_state_blocks = 0
var int audit_mix_ema_ok_regime_fail = 0
var int audit_mix_regime_ok_ema_fail = 0
var int audit_mix_opp_persist_wait = 0
var int audit_mix_ema_regime_fail = 0
var int audit_last_event_bar = na
var int audit_last_state_bar = na
var string audit_last_chain = "RL:0 RS:0 | GL:0 GS:0 | FL:0 FS:0"
var string audit_last_reason = "SRC:YOK | X:YOK | B:YOK | ST:F>F"
var string audit_last_state = "FLAT>FLAT"
var string audit_last_state_reason = "YOK"
var audit_last_chain_bg = color.rgb(70, 70, 70)
var audit_last_reason_bg = color.rgb(70, 70, 70)
var audit_last_state_bg = color.rgb(70, 70, 70)

confirmed_bar = barstate.isconfirmed

// ── State Desync Takibi (indikatör tarafı) ─────────────────
var int audit_state_desyncs = 0
var string last_desync_reason = "YOK"
state_desync = false  // indikatörde broker emulator yok, manuel takip

//====================================================
// REGIME
//====================================================

//====================================================
// ENGINE
//====================================================
[st_line, st_dir] = ta.supertrend(st_factor, st_atr_len)
st_is_up       = st_dir < 0

regime_ema   = ta.ema(close, ema_len)
ema_regime_slope = ta.sma(regime_ema - regime_ema[1], 3)
ema_slope_long_ok = ema_regime_slope > 0
ema_slope_short_ok = ema_regime_slope < 0

at_atr             = ta.sma(ta.tr, at_len)
at_up_trend        = low - at_atr * at_mult
at_down_trend      = high + at_atr * at_mult
at_momentum_up     = at_no_volume_mode ? ta.rsi(at_src, at_len) >= 50 : ta.mfi(hlc3, at_len) >= 50
var float at_line  = 0.0
at_prev_line       = nz(at_line[1], 0.0)
at_line            := at_momentum_up ? (at_up_trend < at_prev_line ? at_prev_line : at_up_trend) : (at_down_trend > at_prev_line ? at_prev_line : at_down_trend)

gc_src    = close
var float gc_a = na
var float gc_b = na
gc_prev_a = nz(gc_a[1], gc_src)
gc_prev_b = nz(gc_b[1], gc_src)
gc_a      := math.max(gc_src, gc_prev_a) - ((gc_prev_a - gc_prev_b) / gc_len)
gc_b      := math.min(gc_src, gc_prev_b) + ((gc_prev_a - gc_prev_b) / gc_len)
gc_mid    = (gc_a + gc_b) * 0.5

engine_plot_line = (using_at or using_atema) ? at_line : (using_gc or using_gcema) ? gc_mid : (using_st or using_stema) ? st_line : regime_ema
regime_long_threshold  = engine_plot_line
regime_short_threshold = engine_plot_line
regime_long_ok  = close > regime_long_threshold
regime_short_ok = close < regime_short_threshold
regime_state    = regime_long_ok ? "LONG" : regime_short_ok ? "SHORT" : "NEUTRAL"

core_ema_long_ok  = using_ema ? true : close > regime_ema
core_ema_short_ok = using_ema ? true : close < regime_ema
entry_side_long_base_ok  = regime_long_ok and core_ema_long_ok
entry_side_short_base_ok = regime_short_ok and core_ema_short_ok

atema_long_entry_ok  = regime_long_ok and core_ema_long_ok and at_line > regime_ema
atema_short_entry_ok = regime_short_ok and core_ema_short_ok and at_line < regime_ema
gcema_line = gc_mid
gcema_long_entry_ok  = regime_long_ok and core_ema_long_ok and gcema_line > regime_ema
gcema_short_entry_ok = regime_short_ok and core_ema_short_ok and gcema_line < regime_ema
// ST-EMA: Fiyat > ST > EMA200 stack (giriş), sadece EMA200 bazlı hold
stema_long_entry_ok  = regime_long_ok and core_ema_long_ok and st_line > regime_ema
stema_short_entry_ok = regime_short_ok and core_ema_short_ok and st_line < regime_ema

atema_long_hold_ok   = close > regime_ema
atema_short_hold_ok  = close < regime_ema
gcema_long_hold_ok   = close > regime_ema
gcema_short_hold_ok  = close < regime_ema
stema_long_hold_ok   = close > regime_ema
stema_short_hold_ok  = close < regime_ema

atema_dashboard_long_ok  = atema_long_entry_ok or (trade_state == STATE_LONG and atema_long_hold_ok and not atema_short_entry_ok)
atema_dashboard_short_ok = atema_short_entry_ok or (trade_state == STATE_SHORT and atema_short_hold_ok and not atema_long_entry_ok)
gcema_dashboard_long_ok  = gcema_long_entry_ok or (trade_state == STATE_LONG and gcema_long_hold_ok and not gcema_short_entry_ok)
gcema_dashboard_short_ok = gcema_short_entry_ok or (trade_state == STATE_SHORT and gcema_short_hold_ok and not gcema_long_entry_ok)
stema_dashboard_long_ok  = stema_long_entry_ok or (trade_state == STATE_LONG and stema_long_hold_ok and not stema_short_entry_ok)
stema_dashboard_short_ok = stema_short_entry_ok or (trade_state == STATE_SHORT and stema_short_hold_ok and not stema_long_entry_ok)

entry_side_long_seed_ok  = using_atema ? atema_long_entry_ok : using_gcema ? gcema_long_entry_ok : using_stema ? stema_long_entry_ok : entry_side_long_base_ok
entry_side_short_seed_ok = using_atema ? atema_short_entry_ok : using_gcema ? gcema_short_entry_ok : using_stema ? stema_short_entry_ok : entry_side_short_base_ok

var int hybrid_long_hold_bars = 0
var int hybrid_short_hold_bars = 0
hybrid_long_hold_bars  := entry_side_long_seed_ok  ? nz(hybrid_long_hold_bars[1])  + 1 : 0
hybrid_short_hold_bars := entry_side_short_seed_ok ? nz(hybrid_short_hold_bars[1]) + 1 : 0

hybrid_long_persist_ok  = not use_regime_persistence or hybrid_long_hold_bars  >= regime_persistence_bars
hybrid_short_persist_ok = not use_regime_persistence or hybrid_short_hold_bars >= regime_persistence_bars

hybrid_long_persist_event  = confirmed_bar and use_regime_persistence and hybrid_long_hold_bars  >= regime_persistence_bars and nz(hybrid_long_hold_bars[1])  < regime_persistence_bars
hybrid_short_persist_event = confirmed_bar and use_regime_persistence and hybrid_short_hold_bars >= regime_persistence_bars and nz(hybrid_short_hold_bars[1]) < regime_persistence_bars

entry_side_long_ok  = entry_side_long_seed_ok  and hybrid_long_persist_ok
entry_side_short_ok = entry_side_short_seed_ok and hybrid_short_persist_ok
regime_persistence_text = not use_regime_persistence ? "KAPALI" : entry_side_long_seed_ok ? "LONG " + str.tostring(math.min(hybrid_long_hold_bars, regime_persistence_bars)) + "/" + str.tostring(regime_persistence_bars) : entry_side_short_seed_ok ? "SHORT " + str.tostring(math.min(hybrid_short_hold_bars, regime_persistence_bars)) + "/" + str.tostring(regime_persistence_bars) : "NOTR 0/" + str.tostring(regime_persistence_bars)
regime_persistence_bg = not use_regime_persistence ? color.rgb(70, 70, 70) : entry_side_long_ok ? color.rgb(20, 115, 60) : entry_side_short_ok ? color.rgb(150, 35, 35) : (entry_side_long_seed_ok or entry_side_short_seed_ok) ? color.rgb(160, 110, 20) : color.rgb(70, 70, 70)

hybrid_long_state  = entry_side_long_ok
hybrid_short_state = entry_side_short_ok
hybrid_long_prev   = bar_index > 0 ? hybrid_long_state[1]  : false
hybrid_short_prev  = bar_index > 0 ? hybrid_short_state[1] : false
selected_motor_long_ok  = using_atema ? atema_dashboard_long_ok  : using_gcema ? gcema_dashboard_long_ok  : using_stema ? stema_dashboard_long_ok  : hybrid_long_state
selected_motor_short_ok = using_atema ? atema_dashboard_short_ok : using_gcema ? gcema_dashboard_short_ok : using_stema ? stema_dashboard_short_ok : hybrid_short_state

primary_entry_source_label = engine_label + "_ANA"
primary_exit_source_label  = engine_label + " REV"
mismatch_exit_source_label = using_atema ? "ATEMA STOP" : using_gcema ? "GCEMA STOP" : using_stema ? "STEMA STOP" : MIX_EXIT_SOURCE_LABEL
mix_detail_ema_ok_regime_fail = using_at ? MIX_DETAIL_EMA_OK_AT_FAIL : using_gc ? MIX_DETAIL_EMA_OK_GC_FAIL : using_st ? MIX_DETAIL_EMA_OK_ST_FAIL : using_ema ? MIX_DETAIL_EMA_OK_EMA_FAIL : using_atema ? MIX_DETAIL_EMA_OK_ATEMA_FAIL : MIX_DETAIL_EMA_OK_GCEMA_FAIL
mix_detail_regime_ok_ema_fail = using_at ? MIX_DETAIL_AT_OK_EMA_FAIL : using_gc ? MIX_DETAIL_GC_OK_EMA_FAIL : using_st ? MIX_DETAIL_ST_OK_EMA_FAIL : using_ema ? MIX_DETAIL_EMA_MOTOR_OK_FAIL : using_atema ? MIX_DETAIL_ATEMA_OK_EMA_FAIL : MIX_DETAIL_GCEMA_OK_EMA_FAIL
mix_detail_ema_regime_fail    = using_at ? MIX_DETAIL_EMA_AT_FAIL : using_gc ? MIX_DETAIL_EMA_GC_FAIL : using_st ? MIX_DETAIL_EMA_ST_FAIL : using_ema ? MIX_DETAIL_EMA_FAIL : using_atema ? MIX_DETAIL_EMA_ATEMA_FAIL : MIX_DETAIL_EMA_GCEMA_FAIL
mix_exit_detail_long  = core_ema_long_ok  and not regime_long_ok  ? mix_detail_ema_ok_regime_fail : regime_long_ok  and not core_ema_long_ok  ? mix_detail_regime_ok_ema_fail : (not using_atema and not using_gcema and not using_stema and entry_side_short_seed_ok and not hybrid_short_state) ? MIX_DETAIL_OPP_PERSIST_WAIT : mix_detail_ema_regime_fail
mix_exit_detail_short = core_ema_short_ok and not regime_short_ok ? mix_detail_ema_ok_regime_fail : regime_short_ok and not core_ema_short_ok ? mix_detail_regime_ok_ema_fail : (not using_atema and not using_gcema and not using_stema and entry_side_long_seed_ok  and not hybrid_long_state)  ? MIX_DETAIL_OPP_PERSIST_WAIT : mix_detail_ema_regime_fail
engine_long_primary  = confirmed_bar and hybrid_long_state  and not hybrid_long_prev
engine_short_primary = confirmed_bar and hybrid_short_state and not hybrid_short_prev
entry_regime_long_ok  = entry_side_long_ok
entry_regime_short_ok = entry_side_short_ok

regime_cross_long  = ta.crossover(close,  regime_long_threshold)
regime_cross_short = ta.crossunder(close, regime_short_threshold)

reclaim_cross_long  = long_flip_reclaim_armed  and not na(last_long_exit_price)  and close[1] <= last_long_exit_price  and close > last_long_exit_price
reclaim_cross_short = short_flip_reclaim_armed and not na(last_short_exit_price) and close[1] >= last_short_exit_price and close < last_short_exit_price
reclaim_long_direction_ok  = entry_side_long_ok
reclaim_short_direction_ok = entry_side_short_ok

engine_long_reclaim_cont  = confirmed_bar and reclaim_cross_long  and reclaim_long_direction_ok
engine_short_reclaim_cont = confirmed_bar and reclaim_cross_short and reclaim_short_direction_ok
ema_cont_long_core   = false
ema_cont_short_core  = false

if confirmed_bar
    if engine_short_primary
        long_setup_age := na
    else if not na(long_setup_age)
        long_setup_age += 1
        if long_setup_age > setup_memory_after_bars
            long_setup_age := na

    if engine_long_primary
        short_setup_age := na
    else if not na(short_setup_age)
        short_setup_age += 1
        if short_setup_age > setup_memory_after_bars
            short_setup_age := na

engine_long_event  = engine_long_primary
engine_short_event = engine_short_primary
motor_state = engine_label + " / " + (selected_motor_long_ok ? "LONG" : selected_motor_short_ok ? "SHORT" : "MIX")
motor_state_bg = selected_motor_long_ok ? color.rgb(20, 140, 95) : selected_motor_short_ok ? color.rgb(150, 35, 35) : color.rgb(70, 70, 70)
at_long_ok  = close > at_line
at_short_ok = close < at_line
gc_long_ok  = close > gc_mid
gc_short_ok = close < gc_mid
st_long_ok  = st_is_up
st_short_ok = not st_is_up
ema_motor_long_ok  = close > regime_ema
ema_motor_short_ok = close < regime_ema
gcema_motor_long_ok  = gcema_dashboard_long_ok
gcema_motor_short_ok = gcema_dashboard_short_ok
at_motor_state    = motor_dash_text("AT",     using_at,    at_long_ok,              at_short_ok)
gc_motor_state    = motor_dash_text("GC",     using_gc,    gc_long_ok,              gc_short_ok)
st_motor_state    = motor_dash_text("ST",     using_st,    st_long_ok,              st_short_ok)
ema_motor_state   = motor_dash_text("EMA",    using_ema,   ema_motor_long_ok,       ema_motor_short_ok)
atema_motor_state = motor_dash_text("AT-EMA", using_atema, atema_dashboard_long_ok, atema_dashboard_short_ok)
gcema_motor_state = motor_dash_text("GC-EMA", using_gcema, gcema_motor_long_ok,     gcema_motor_short_ok)
stema_motor_state = motor_dash_text("ST-EMA", using_stema, stema_dashboard_long_ok, stema_dashboard_short_ok)
at_motor_bg    = motor_dash_bg(using_at,    at_long_ok,              at_short_ok)
gc_motor_bg    = motor_dash_bg(using_gc,    gc_long_ok,              gc_short_ok)
st_motor_bg    = motor_dash_bg(using_st,    st_long_ok,              st_short_ok)
ema_motor_bg   = motor_dash_bg(using_ema,   ema_motor_long_ok,       ema_motor_short_ok)
atema_motor_bg = motor_dash_bg(using_atema, atema_dashboard_long_ok, atema_dashboard_short_ok)
gcema_motor_bg = motor_dash_bg(using_gcema, gcema_motor_long_ok,     gcema_motor_short_ok)
stema_motor_bg = motor_dash_bg(using_stema, stema_dashboard_long_ok, stema_dashboard_short_ok)

//====================================================
// FILTERS
//====================================================
chart_tf_seconds  = timeframe.in_seconds(timeframe.period)
mtf_tf_seconds    = timeframe.in_seconds(mtf_tf)
mtf_filter_active = use_mtf_filter and mtf_tf_seconds > chart_tf_seconds
mtf_close = request.security(syminfo.tickerid, mtf_tf, close[1],              gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
mtf_ema   = request.security(syminfo.tickerid, mtf_tf, ta.ema(close, mtf_ema_len)[1], gaps=barmerge.gaps_off, lookahead=barmerge.lookahead_on)
mtf_long_ok  = not mtf_filter_active ? true : mtf_close > mtf_ema
mtf_short_ok = not mtf_filter_active ? true : mtf_close < mtf_ema

gchannel_filter_active   = false
gchannel_filter_long_ok  = true
gchannel_filter_short_ok = true

rsi_filter_value   = ta.rsi(close, rsi_filter_len)
var int rsi_above_bars = 0
var int rsi_below_bars = 0
rsi_above_bars := rsi_filter_value > rsi_long_min  ? nz(rsi_above_bars[1]) + 1 : 0
rsi_below_bars := rsi_filter_value < rsi_short_max ? nz(rsi_below_bars[1]) + 1 : 0
rsi_filter_long_ok  = not use_rsi_filter ? true : rsi_above_bars >= rsi_confirm_bars
rsi_filter_short_ok = not use_rsi_filter ? true : rsi_below_bars >= rsi_confirm_bars
[_adx_plus, _adx_minus, adx_value] = ta.dmi(adx_len, adx_len)
adx_filter_ok = not use_adx_filter ? true : adx_value >= adx_min

all_long_filters_ok  = mtf_long_ok  and rsi_filter_long_ok  and adx_filter_ok
all_short_filters_ok = mtf_short_ok and rsi_filter_short_ok and adx_filter_ok

active_filter_count = (mtf_filter_active ? 1 : 0) + (use_rsi_filter ? 1 : 0) + (use_adx_filter ? 1 : 0)
config_safe  = active_filter_count <= 3
config_state = config_safe ? "GUVENLI" : "OVERFIT RISK"

//====================================================
// DIRECT EVENT SIGNALS
//====================================================
long_primary_reclaim_ok  = true
short_primary_reclaim_ok = true

raw_long_signal  = confirmed_bar and ((engine_long_primary  and long_primary_reclaim_ok)  or engine_long_reclaim_cont)
raw_short_signal = confirmed_bar and ((engine_short_primary and short_primary_reclaim_ok) or engine_short_reclaim_cont)

long_regime_gate_ok  = entry_side_long_ok
short_regime_gate_ok = entry_side_short_ok

gated_long_signal  = raw_long_signal  and long_regime_gate_ok  and all_long_filters_ok
gated_short_signal = raw_short_signal and short_regime_gate_ok and all_short_filters_ok

long_reentry_ok  = true
short_reentry_ok = true
cooldown_ok      = na(last_exit_bar) or (bar_index - last_exit_bar > entry_cooldown_bars)

backtest_window_enabled = use_backtest_window
in_backtest_window  = not backtest_window_enabled or (time >= backtest_start_time and time <= backtest_end_time)
backtest_window_ended = backtest_window_enabled and time > backtest_end_time
live_alert_window_text = not backtest_window_enabled ? "YOK" : backtest_window_ended ? "BT FILTRE / BITIS GECTI" : time < backtest_start_time ? "BT FILTRE / BASLAMADI" : "BT FILTRE / ACIK"
live_alert_window_bg   = not backtest_window_enabled ? color.rgb(20, 115, 60) : backtest_window_ended or time < backtest_start_time ? color.rgb(150, 35, 35) : color.rgb(180, 90, 20)

long_signal_base  = gated_long_signal  and long_reentry_ok  and cooldown_ok and in_backtest_window
short_signal_base = gated_short_signal and short_reentry_ok and cooldown_ok and in_backtest_window
long_signal  = long_signal_base  and allow_long_entries
short_signal = short_signal_base and allow_short_entries

//====================================================
// SIMULATED POSITION STATE FOR INDICATOR SYNC
//====================================================
var float sim_entry_price = na

in_long_before  = trade_state == STATE_LONG
in_short_before = trade_state == STATE_SHORT
flat_before     = trade_state == STATE_FLAT
engine_opposite_long   = in_long_before  and engine_short_primary and short_signal_base
engine_opposite_short  = in_short_before and engine_long_primary  and long_signal_base
motor_opposite_long  = engine_opposite_long
motor_opposite_short = engine_opposite_short
hybrid_mismatch_long  = confirmed_bar and in_long_before  and not hybrid_long_state  and not hybrid_short_state
hybrid_mismatch_short = confirmed_bar and in_short_before and not hybrid_short_state and not hybrid_long_state
atema_stop_long  = confirmed_bar and using_atema and in_long_before  and not atema_long_hold_ok
atema_stop_short = confirmed_bar and using_atema and in_short_before and not atema_short_hold_ok
gcema_stop_long  = confirmed_bar and using_gcema and in_long_before  and not gcema_long_hold_ok
gcema_stop_short = confirmed_bar and using_gcema and in_short_before and not gcema_short_hold_ok
stema_stop_long  = confirmed_bar and using_stema and in_long_before  and not stema_long_hold_ok
stema_stop_short = confirmed_bar and using_stema and in_short_before and not stema_short_hold_ok
reverse_close_long  = safe_motor_flip_exit and motor_opposite_long
reverse_close_short = safe_motor_flip_exit and motor_opposite_short

// ── PARITY DÜZELTMESİ (v9.9.20b): using_stema dalı eklendi ──────────────────
regime_close_long  = using_atema ? (atema_stop_long  and not reverse_close_long)  : using_gcema ? (gcema_stop_long  and not reverse_close_long)  : using_stema ? (stema_stop_long  and not reverse_close_long)  : hybrid_mismatch_long
regime_close_short = using_atema ? (atema_stop_short and not reverse_close_short) : using_gcema ? (gcema_stop_short and not reverse_close_short) : using_stema ? (stema_stop_short and not reverse_close_short) : hybrid_mismatch_short
// ─────────────────────────────────────────────────────────────────────────────

mix_exit_detail_now = regime_close_long ? mix_exit_detail_long : regime_close_short ? mix_exit_detail_short : "YOK"
just_closed_this_bar = reverse_close_long or reverse_close_short or regime_close_long or regime_close_short
long_exit_happened  = reverse_close_long  or regime_close_long
short_exit_happened = reverse_close_short or regime_close_short

long_profit_exit  = in_long_before  and just_closed_this_bar and close > sim_entry_price
short_profit_exit = in_short_before and just_closed_this_bar and close < sim_entry_price

if reverse_close_long or reverse_close_short
    last_exit_reason := primary_exit_source_label
    last_exit_bg := color.rgb(20, 140, 95)
else if regime_close_long or regime_close_short
    last_exit_reason := mismatch_exit_source_label + "/" + mix_exit_detail_now
    last_exit_bg := color.rgb(160, 110, 20)
    last_mix_detail := mix_exit_detail_now
    if mix_exit_detail_now == MIX_DETAIL_EMA_OK_AT_FAIL or mix_exit_detail_now == MIX_DETAIL_EMA_OK_GC_FAIL or mix_exit_detail_now == MIX_DETAIL_EMA_OK_ST_FAIL or mix_exit_detail_now == MIX_DETAIL_EMA_OK_GCEMA_FAIL
        audit_mix_ema_ok_regime_fail += 1
    else if mix_exit_detail_now == MIX_DETAIL_AT_OK_EMA_FAIL or mix_exit_detail_now == MIX_DETAIL_GC_OK_EMA_FAIL or mix_exit_detail_now == MIX_DETAIL_ST_OK_EMA_FAIL or mix_exit_detail_now == MIX_DETAIL_GCEMA_OK_EMA_FAIL
        audit_mix_regime_ok_ema_fail += 1
    else if mix_exit_detail_now == MIX_DETAIL_OPP_PERSIST_WAIT
        audit_mix_opp_persist_wait += 1
    else
        audit_mix_ema_regime_fail += 1

if long_exit_happened
    if regime_close_long and (mix_exit_detail_now == MIX_DETAIL_EMA_OK_AT_FAIL or mix_exit_detail_now == MIX_DETAIL_EMA_OK_GC_FAIL or mix_exit_detail_now == MIX_DETAIL_EMA_OK_ST_FAIL)
        last_long_exit_price := regime_long_threshold
        long_flip_reclaim_armed := true
    else
        last_long_exit_price := na
        long_flip_reclaim_armed := false

if short_exit_happened
    if regime_close_short and (mix_exit_detail_now == MIX_DETAIL_EMA_OK_AT_FAIL or mix_exit_detail_now == MIX_DETAIL_EMA_OK_GC_FAIL or mix_exit_detail_now == MIX_DETAIL_EMA_OK_ST_FAIL)
        last_short_exit_price := regime_short_threshold
        short_flip_reclaim_armed := true
    else
        last_short_exit_price := na
        short_flip_reclaim_armed := false

if long_profit_exit
    if engine_short_primary
        long_reentry_lock := true
        long_reentry_level := close
        long_tp_wait_reset := false
    else
        long_tp_wait_reset := true
        long_reentry_lock := false
        long_reentry_level := na

if short_profit_exit
    if engine_long_primary
        short_reentry_lock := true
        short_reentry_level := close
        short_tp_wait_reset := false
    else
        short_tp_wait_reset := true
        short_reentry_lock := false
        short_reentry_level := na

if atema_stop_long or atema_stop_short or stema_stop_long or stema_stop_short
    long_tp_wait_reset := false
    short_tp_wait_reset := false

if long_tp_wait_reset and flat_before and engine_short_primary
    long_reentry_lock := true
    long_reentry_level := close
    long_tp_wait_reset := false

if short_tp_wait_reset and flat_before and engine_long_primary
    short_reentry_lock := true
    short_reentry_level := close
    short_tp_wait_reset := false

if long_reentry_lock and regime_short_ok
    long_reentry_lock := false
    long_reentry_level := na
    long_tp_wait_reset := false

if short_reentry_lock and regime_long_ok
    short_reentry_lock := false
    short_reentry_level := na
    short_tp_wait_reset := false

if long_flip_reclaim_armed and entry_side_short_seed_ok
    long_flip_reclaim_armed := false
    last_long_exit_price := na

if short_flip_reclaim_armed and entry_side_long_seed_ok
    short_flip_reclaim_armed := false
    last_short_exit_price := na

allow_long_reversal  = allow_long_entries  and in_short_before and engine_long_primary  and long_signal_base
allow_short_reversal = allow_short_entries and in_long_before  and engine_short_primary and short_signal_base

//====================================================
// DEBUG SIGNAL PATH
//====================================================
dbg_raw_long      = raw_long_signal
dbg_raw_short     = raw_short_signal
dbg_final_long    = long_signal
dbg_final_short   = short_signal
dbg_reentry_block_long  = gated_long_signal  and not long_reentry_ok
dbg_reentry_block_short = gated_short_signal and not short_reentry_ok
dbg_cooldown_block_long  = gated_long_signal  and long_reentry_ok  and not cooldown_ok
dbg_cooldown_block_short = gated_short_signal and short_reentry_ok and not cooldown_ok
dbg_regime_persist_block_long  = raw_long_signal  and entry_side_long_seed_ok  and not entry_side_long_ok
dbg_regime_persist_block_short = raw_short_signal and entry_side_short_seed_ok and not entry_side_short_ok
dbg_regime_block_long    = raw_long_signal  and not long_regime_gate_ok  and not dbg_regime_persist_block_long
dbg_regime_block_short   = raw_short_signal and not short_regime_gate_ok and not dbg_regime_persist_block_short
dbg_filter_block_long    = raw_long_signal  and long_regime_gate_ok  and not all_long_filters_ok
dbg_filter_block_short   = raw_short_signal and short_regime_gate_ok and not all_short_filters_ok
dbg_reclaim_block_long   = confirmed_bar and engine_long_primary  and not long_primary_reclaim_ok
dbg_reclaim_block_short  = confirmed_bar and engine_short_primary and not short_primary_reclaim_ok

pending_long  = false
pending_short = false
pending_long_bars  = na(long_setup_age)  ? 0 : long_setup_age
pending_short_bars = na(short_setup_age) ? 0 : short_setup_age
cooldown_left = na(last_exit_bar) ? 0 : math.max(0, entry_cooldown_bars + 1 - (bar_index - last_exit_bar))

exit_happened = false

if backtest_window_ended and trade_state != STATE_FLAT and not exit_happened
    last_exit_reason := "BACKTEST"
    last_exit_bg := color.rgb(90, 90, 120)
    exit_happened := true

if reverse_close_long  and not exit_happened
    exit_happened := true
if reverse_close_short and not exit_happened
    exit_happened := true
if regime_close_long  and not exit_happened
    exit_happened := true
if regime_close_short and not exit_happened
    exit_happened := true

if exit_happened
    trade_state := STATE_FLAT
    last_exit_bar := bar_index
    sim_entry_price := na
    if backtest_window_ended
        long_setup_age := na
        short_setup_age := na
        long_reentry_lock := false
        short_reentry_lock := false
        long_reentry_level := na
        short_reentry_level := na
        long_flip_reclaim_armed := false
        short_flip_reclaim_armed := false
        last_long_exit_price := na
        last_short_exit_price := na

entry_flat_now = trade_state == STATE_FLAT

fire_long_reversal  = allow_long_reversal
fire_short_reversal = allow_short_reversal
fire_long_flat  = long_signal  and entry_flat_now and not exit_happened and not fire_long_reversal  and not fire_short_reversal
fire_short_flat = short_signal and entry_flat_now and not exit_happened and not fire_long_reversal  and not fire_short_reversal

plot_long_entry  = fire_long_reversal  or fire_long_flat
plot_short_entry = fire_short_reversal or fire_short_flat

dbg_state_block_long  = gated_long_signal  and long_reentry_ok  and cooldown_ok and (not entry_flat_now or (exit_happened and not fire_long_reversal))
dbg_state_block_short = gated_short_signal and short_reentry_ok and cooldown_ok and (not entry_flat_now or (exit_happened and not fire_short_reversal))

block_reason_now = dbg_reclaim_block_long or dbg_reclaim_block_short ? "RECLAIM" : dbg_regime_persist_block_long or dbg_regime_persist_block_short ? "KALICILIK" : dbg_regime_block_long or dbg_regime_block_short ? "REJIM" : dbg_filter_block_long or dbg_filter_block_short ? "FILTRE" : dbg_reentry_block_long or dbg_reentry_block_short ? "RE-ENTRY" : dbg_cooldown_block_long or dbg_cooldown_block_short ? "COOLDOWN" : dbg_state_block_long or dbg_state_block_short ? "STATE" : "YOK"
if confirmed_bar and block_reason_now != "YOK"
    last_block_reason := block_reason_now

reentry_state = long_reentry_lock and short_reentry_lock ? "L+S" : long_reentry_lock ? "LONG" : short_reentry_lock ? "SHORT" : "YOK"
long_entry_source_now  = engine_long_primary  ? primary_entry_source_label : engine_long_reclaim_cont  ? "GERI_KAZANIM" : "YOK"
short_entry_source_now = engine_short_primary ? primary_entry_source_label : engine_short_reclaim_cont ? "GERI_KAZANIM" : "YOK"
bar_status_now = plot_long_entry ? "LONG / " + long_entry_source_now : plot_short_entry ? "SHORT / " + short_entry_source_now : block_reason_now != "YOK" ? ((raw_long_signal or gated_long_signal or long_signal) ? "LONG / " + block_reason_now + " BLOK" : (raw_short_signal or gated_short_signal or short_signal) ? "SHORT / " + block_reason_now + " BLOK" : block_reason_now + " BLOK") : "YOK"
bar_status_bg = plot_long_entry ? color.rgb(20, 115, 60) : plot_short_entry ? color.rgb(150, 35, 35) : block_bg(block_reason_now)
parity_bar_source = raw_long_signal ? long_entry_source_now : raw_short_signal ? short_entry_source_now : "YOK"
parity_bar_exit_is_backtest = backtest_window_ended and exit_happened and (in_long_before or in_short_before)
parity_bar_exit_is_primary  = reverse_close_long or reverse_close_short
parity_bar_exit_is_mix      = regime_close_long  or regime_close_short
parity_bar_exit = parity_bar_exit_is_backtest ? "BACKTEST" : parity_bar_exit_is_primary ? primary_exit_source_label : parity_bar_exit_is_mix ? mismatch_exit_source_label + "/" + mix_exit_detail_now : "YOK"
state_before_text = in_long_before ? "LONG" : in_short_before ? "SHORT" : "FLAT"
state_after_text  = fire_long_reversal or fire_long_flat ? "LONG" : fire_short_reversal or fire_short_flat ? "SHORT" : exit_happened ? "FLAT" : state_before_text
state_before_code = in_long_before ? "L" : in_short_before ? "S" : "F"
state_after_code  = state_after_text == "LONG" ? "L" : state_after_text == "SHORT" ? "S" : "F"
state_change_now  = state_after_text != state_before_text
state_event_reason = fire_long_reversal ? "REV/" + long_entry_source_now : fire_short_reversal ? "REV/" + short_entry_source_now : fire_long_flat ? "GIRIS/" + long_entry_source_now : fire_short_flat ? "GIRIS/" + short_entry_source_now : exit_happened ? "CIKIS/" + parity_bar_exit : "YOK"
state_event_bg = state_after_text == "LONG" ? color.rgb(20, 115, 60) : state_after_text == "SHORT" ? color.rgb(150, 35, 35) : exit_happened ? (parity_bar_exit_is_backtest ? color.rgb(90, 90, 120) : parity_bar_exit_is_primary ? color.rgb(20, 140, 95) : parity_bar_exit_is_mix ? color.rgb(160, 110, 20) : color.rgb(70, 70, 70)) : color.rgb(70, 70, 70)
parity_chain_now = "RL:" + audit_flag(raw_long_signal) + " RS:" + audit_flag(raw_short_signal) + " | GL:" + audit_flag(gated_long_signal) + " GS:" + audit_flag(gated_short_signal) + " | FL:" + audit_flag(long_signal) + " FS:" + audit_flag(short_signal)
parity_reason_now = "SRC:" + parity_bar_source + " | X:" + parity_bar_exit + " | B:" + block_reason_now + " | ST:" + state_before_code + ">" + state_after_code
parity_chain_bg = audit_status_bg(raw_long_signal or gated_long_signal or long_signal, raw_short_signal or gated_short_signal or short_signal)
parity_reason_bg = block_reason_now != "YOK" ? block_bg(block_reason_now) : parity_bar_exit_is_backtest ? color.rgb(90, 90, 120) : parity_bar_exit_is_primary ? color.rgb(20, 140, 95) : parity_bar_exit_is_mix ? color.rgb(160, 110, 20) : parity_bar_source == primary_entry_source_label ? color.rgb(20, 140, 95) : parity_bar_source == "GERI_KAZANIM" ? color.rgb(60, 90, 160) : color.rgb(70, 70, 70)
parity_event_now = raw_long_signal or raw_short_signal or gated_long_signal or gated_short_signal or long_signal or short_signal or block_reason_now != "YOK" or parity_bar_exit != "YOK"
if confirmed_bar and parity_event_now
    audit_last_event_bar := bar_index
    audit_last_chain     := parity_chain_now
    audit_last_reason    := parity_reason_now
    audit_last_chain_bg  := parity_chain_bg
    audit_last_reason_bg := parity_reason_bg
if confirmed_bar and state_change_now
    audit_last_state_bar    := bar_index
    audit_last_state        := state_before_text + ">" + state_after_text
    audit_last_state_reason := state_event_reason
    audit_last_state_bg     := state_event_bg
state_audit_text = na(audit_last_state_bar) ? "YOK" : "#" + str.tostring(audit_last_state_bar) + " " + audit_last_state + " / " + audit_last_state_reason
state_audit_bg   = audit_last_state_bg
parity_bar_text  = na(audit_last_event_bar) ? "YOK" : "#" + str.tostring(audit_last_event_bar) + (audit_last_event_bar == bar_index and parity_event_now ? " / BU BAR" : " / SON")
parity_bar_bg    = na(audit_last_event_bar) ? color.rgb(70, 70, 70) : audit_last_reason_bg

if confirmed_bar
    audit_regime_blocks        += (dbg_regime_block_long        ? 1 : 0) + (dbg_regime_block_short        ? 1 : 0)
    audit_regime_persist_blocks += (dbg_regime_persist_block_long ? 1 : 0) + (dbg_regime_persist_block_short ? 1 : 0)
    audit_filter_blocks        += (dbg_filter_block_long         ? 1 : 0) + (dbg_filter_block_short         ? 1 : 0)
    audit_reentry_blocks       += (dbg_reentry_block_long        ? 1 : 0) + (dbg_reentry_block_short        ? 1 : 0)
    audit_reclaim_blocks       += (dbg_reclaim_block_long        ? 1 : 0) + (dbg_reclaim_block_short        ? 1 : 0)
    audit_cooldown_blocks      += (dbg_cooldown_block_long       ? 1 : 0) + (dbg_cooldown_block_short       ? 1 : 0)
    audit_state_blocks         += (dbg_state_block_long          ? 1 : 0) + (dbg_state_block_short          ? 1 : 0)

if fire_long_reversal
    trade_state := STATE_LONG
    last_entry_source := long_entry_source_now
    long_setup_age := na
    short_setup_age := na
    sim_entry_price := close
    long_tp_wait_reset := false
    short_tp_wait_reset := false
    long_reentry_lock := false
    long_reentry_level := na
    short_reentry_lock := false
    short_reentry_level := na
    long_flip_reclaim_armed := false
    short_flip_reclaim_armed := false
    last_long_exit_price := na
    last_short_exit_price := na

if fire_short_reversal
    trade_state := STATE_SHORT
    last_entry_source := short_entry_source_now
    long_setup_age := na
    short_setup_age := na
    sim_entry_price := close
    long_tp_wait_reset := false
    short_tp_wait_reset := false
    long_reentry_lock := false
    long_reentry_level := na
    short_reentry_lock := false
    short_reentry_level := na
    long_flip_reclaim_armed := false
    short_flip_reclaim_armed := false
    last_long_exit_price := na
    last_short_exit_price := na

if fire_long_flat
    trade_state := STATE_LONG
    last_entry_source := long_entry_source_now
    long_setup_age := na
    short_setup_age := na
    sim_entry_price := close
    long_tp_wait_reset := false
    short_tp_wait_reset := false
    long_reentry_lock := false
    long_reentry_level := na
    short_reentry_lock := false
    short_reentry_level := na
    long_flip_reclaim_armed := false
    short_flip_reclaim_armed := false
    last_long_exit_price := na
    last_short_exit_price := na

if fire_short_flat
    trade_state := STATE_SHORT
    last_entry_source := short_entry_source_now
    long_setup_age := na
    short_setup_age := na
    sim_entry_price := close
    long_tp_wait_reset := false
    short_tp_wait_reset := false
    short_reentry_lock := false
    short_reentry_level := na
    long_reentry_lock := false
    long_reentry_level := na
    long_flip_reclaim_armed := false
    short_flip_reclaim_armed := false
    last_long_exit_price := na
    last_short_exit_price := na

in_long  = trade_state == STATE_LONG
in_short = trade_state == STATE_SHORT
position_state = in_long ? "LONG" : in_short ? "SHORT" : "BOS"

//====================================================
// DEBUG CONDITIONS
//====================================================
long_filter_blocked  = raw_long_signal  and long_regime_gate_ok  and not all_long_filters_ok
short_filter_blocked = raw_short_signal and short_regime_gate_ok and not all_short_filters_ok
long_reentry_blocked  = gated_long_signal  and not long_reentry_ok
short_reentry_blocked = gated_short_signal and not short_reentry_ok
long_reclaim_blocked  = confirmed_bar and engine_long_primary  and not long_primary_reclaim_ok
short_reclaim_blocked = confirmed_bar and engine_short_primary and not short_primary_reclaim_ok
long_regime_blocked   = raw_long_signal  and not long_regime_gate_ok
short_regime_blocked  = raw_short_signal and not short_regime_gate_ok
long_exitlock_blocked  = gated_long_signal  and flat_before and (just_closed_this_bar or not cooldown_ok)
short_exitlock_blocked = gated_short_signal and flat_before and (just_closed_this_bar or not cooldown_ok)
long_position_blocked  = gated_long_signal  and not flat_before and not allow_long_reversal
short_position_blocked = gated_short_signal and not flat_before and not allow_short_reversal

//====================================================
// PLOT VISIBILITY SWITCHES
//====================================================
show_regime_ema_final = show_regime_ema_plot and not (show_motor_plot and using_ema)
show_supertrend_final = show_supertrend_plot
show_mtf_ema_final    = show_mtf_ema_plot and mtf_filter_active
show_motor_final      = show_motor_plot
show_at_raw_final     = show_at_raw_plot and not (show_motor_plot and using_at)
show_gc_raw_final     = show_gc_raw_plot and not (show_motor_plot and using_gc)

//====================================================
// VISUALS
//====================================================
plot(show_regime_ema_final ? regime_ema   : na, "EMA200",        color=color.gray,                         linewidth=2)
plot(show_supertrend_final ? st_line      : na, "SuperTrend",    color=st_is_up ? color.lime : color.red,  linewidth=2)
plot(show_mtf_ema_final    ? mtf_ema      : na, "MTF EMA",       color=color.fuchsia,                      linewidth=2)
plot(show_motor_final      ? engine_plot_line : na, "Unified Motor", color=color.black,                    linewidth=2)
plot(show_at_raw_final     ? at_line      : na, "AT Raw",        color=color.teal,                         linewidth=2)
plot(show_gc_raw_final     ? gc_mid       : na, "GC Raw",        color=color.blue,                         linewidth=2)

open_long_evt   = confirmed_bar and plot_long_entry
open_short_evt  = confirmed_bar and plot_short_entry
close_long_evt  = confirmed_bar and (((backtest_window_ended and in_long_before)  or long_exit_happened)  and exit_happened)
close_short_evt = confirmed_bar and (((backtest_window_ended and in_short_before) or short_exit_happened) and exit_happened)

alertcondition(open_long_evt,   title="OZK LONG AC",    message="LONG_AC")
alertcondition(close_long_evt,  title="OZK LONG KAPAT", message="LONG_KAPAT")
alertcondition(open_short_evt,  title="OZK SHORT AC",   message="SHORT_AC")
alertcondition(close_short_evt, title="OZK SHORT KAPAT",message="SHORT_KAPAT")

marker_atr          = ta.atr(14)
long_entry_marker_y  = low  - marker_atr * 0.20
short_entry_marker_y = high + marker_atr * 0.20
long_exit_marker_y   = high + marker_atr * 0.35
short_exit_marker_y  = low  - marker_atr * 0.35

plotshape(show_shapes and visual_mode_same and open_long_evt,  title="Long Signal",  style=shape.triangleup,   location=location.belowbar, color=color.lime, size=size.small, text="L")
plotshape(show_shapes and visual_mode_same and open_short_evt, title="Short Signal", style=shape.triangledown, location=location.abovebar, color=color.red,  size=size.small, text="S")

plotshape(show_shapes and show_exit_shapes and visual_mode_same and reverse_close_long,  title="Close Long Reverse",  style=shape.diamond, location=location.abovebar, color=color.fuchsia, size=size.tiny, text="XL")
plotshape(show_shapes and show_exit_shapes and visual_mode_same and reverse_close_short, title="Close Short Reverse", style=shape.diamond, location=location.belowbar, color=color.fuchsia, size=size.tiny, text="XS")
plotshape(show_shapes and show_exit_shapes and visual_mode_same and regime_close_long,   title="Close Long Mix",      style=shape.diamond, location=location.abovebar, color=color.yellow,  size=size.tiny, text="RL")
plotshape(show_shapes and show_exit_shapes and visual_mode_same and regime_close_short,  title="Close Short Mix",     style=shape.diamond, location=location.belowbar, color=color.yellow,  size=size.tiny, text="RS")

plotshape(show_shapes and visual_mode_debug and marker_size_small  and open_long_evt  ? long_entry_marker_y  : na, title="Indicator Open Long S",  style=shape.labelup,   location=location.absolute, color=color.aqua,    textcolor=color.black, size=size.small,  text="IND AL")
plotshape(show_shapes and visual_mode_debug and marker_size_normal and open_long_evt  ? long_entry_marker_y  : na, title="Indicator Open Long N",  style=shape.labelup,   location=location.absolute, color=color.aqua,    textcolor=color.black, size=size.normal, text="IND AL")
plotshape(show_shapes and visual_mode_debug and marker_size_large  and open_long_evt  ? long_entry_marker_y  : na, title="Indicator Open Long L",  style=shape.labelup,   location=location.absolute, color=color.aqua,    textcolor=color.black, size=size.large,  text="IND AL")
plotshape(show_shapes and visual_mode_debug and marker_size_small  and open_short_evt ? short_entry_marker_y : na, title="Indicator Open Short S", style=shape.labeldown, location=location.absolute, color=color.fuchsia, textcolor=color.white, size=size.small,  text="IND SAT")
plotshape(show_shapes and visual_mode_debug and marker_size_normal and open_short_evt ? short_entry_marker_y : na, title="Indicator Open Short N", style=shape.labeldown, location=location.absolute, color=color.fuchsia, textcolor=color.white, size=size.normal, text="IND SAT")
plotshape(show_shapes and visual_mode_debug and marker_size_large  and open_short_evt ? short_entry_marker_y : na, title="Indicator Open Short L", style=shape.labeldown, location=location.absolute, color=color.fuchsia, textcolor=color.white, size=size.large,  text="IND SAT")

plotshape(show_shapes and show_exit_shapes and visual_mode_debug and marker_size_small  and close_long_evt  ? long_exit_marker_y  : na, title="Indicator Close Long S",  style=shape.labeldown, location=location.absolute, color=color.orange, textcolor=color.white, size=size.small,  text="IND XL")
plotshape(show_shapes and show_exit_shapes and visual_mode_debug and marker_size_normal and close_long_evt  ? long_exit_marker_y  : na, title="Indicator Close Long N",  style=shape.labeldown, location=location.absolute, color=color.orange, textcolor=color.white, size=size.normal, text="IND XL")
plotshape(show_shapes and show_exit_shapes and visual_mode_debug and marker_size_large  and close_long_evt  ? long_exit_marker_y  : na, title="Indicator Close Long L",  style=shape.labeldown, location=location.absolute, color=color.orange, textcolor=color.white, size=size.large,  text="IND XL")
plotshape(show_shapes and show_exit_shapes and visual_mode_debug and marker_size_small  and close_short_evt ? short_exit_marker_y : na, title="Indicator Close Short S", style=shape.labelup,   location=location.absolute, color=color.orange, textcolor=color.white, size=size.small,  text="IND XS")
plotshape(show_shapes and show_exit_shapes and visual_mode_debug and marker_size_normal and close_short_evt ? short_exit_marker_y : na, title="Indicator Close Short N", style=shape.labelup,   location=location.absolute, color=color.orange, textcolor=color.white, size=size.normal, text="IND XS")
plotshape(show_shapes and show_exit_shapes and visual_mode_debug and marker_size_large  and close_short_evt ? short_exit_marker_y : na, title="Indicator Close Short L", style=shape.labelup,   location=location.absolute, color=color.orange, textcolor=color.white, size=size.large,  text="IND XS")

long_zone  = show_filter_boxes and active_filter_count > 0 and regime_long_ok  and all_long_filters_ok
short_zone = show_filter_boxes and active_filter_count > 0 and regime_short_ok and all_short_filters_ok
bgcolor(long_zone ? color.new(color.lime, 88) : short_zone ? color.new(color.red, 88) : na)

//====================================================
// DASHBOARD
//====================================================
dashboard_pos = dashboard_y == "top" ? (dashboard_x == "left" ? position.top_left : dashboard_x == "center" ? position.top_center : position.top_right) : dashboard_y == "middle" ? (dashboard_x == "left" ? position.middle_left : dashboard_x == "center" ? position.middle_center : position.middle_right) : (dashboard_x == "left" ? position.bottom_left : dashboard_x == "center" ? position.bottom_center : position.bottom_right)
dash_text_size = cell_text_size(dashboard_size)
dash_key = dashboard_y + "|" + dashboard_x + "|" + dashboard_size
var string dash_key_prev = ""
var bool dash_show_prev = false
var table dash = na

dash_needs_rebuild = na(dash) or dash_key != dash_key_prev or show_dashboard != dash_show_prev
if dash_needs_rebuild
    if not na(dash)
        table.delete(dash)
    dash := show_dashboard ? table.new(dashboard_pos, 2, 50, border_width=1) : na
    dash_key_prev  := dash_key
    dash_show_prev := show_dashboard

if show_dashboard and na(dash)
    dash := table.new(dashboard_pos, 2, 50, border_width=1)
    dash_key_prev  := dash_key
    dash_show_prev := show_dashboard

if show_dashboard and not na(dash)
    table.clear(dash, 0, 0, 1, 49)
    if show_dashboard
        row = 0
        hdr      = color.rgb(18, 24, 32)
        label_bg = color.rgb(46, 54, 66)

        table.cell(dash, 0, row, "KALEM", text_color=color.white, bgcolor=hdr, text_size=dash_text_size)
        table.cell(dash, 1, row, "DURUM", text_color=color.white, bgcolor=hdr, text_size=dash_text_size)
        row += 1

        table.cell(dash, 0, row, "REJIM", text_color=color.white, bgcolor=label_bg, text_size=dash_text_size)
        table.cell(dash, 1, row, regime_state, text_color=color.white, bgcolor=status_bg(regime_long_ok, regime_short_ok), text_size=dash_text_size)
        row += 1

        table.cell(dash, 0, row, "HIBRIT KALICILIK", text_color=color.white, bgcolor=label_bg, text_size=dash_text_size)
        table.cell(dash, 1, row, regime_persistence_text, text_color=color.white, bgcolor=regime_persistence_bg, text_size=dash_text_size)
        row += 1

        table.cell(dash, 0, row, "MOTOR", text_color=color.white, bgcolor=label_bg, text_size=dash_text_size)
        table.cell(dash, 1, row, motor_state, text_color=color.white, bgcolor=motor_state_bg, text_size=dash_text_size)
        row += 1

        table.cell(dash, 0, row, "AT DURUM", text_color=color.white, bgcolor=label_bg, text_size=dash_text_size)
        table.cell(dash, 1, row, at_motor_state, text_color=color.white, bgcolor=at_motor_bg, text_size=dash_text_size)
        row += 1

        table.cell(dash, 0, row, "GC DURUM", text_color=color.white, bgcolor=label_bg, text_size=dash_text_size)
        table.cell(dash, 1, row, gc_motor_state, text_color=color.white, bgcolor=gc_motor_bg, text_size=dash_text_size)
        row += 1

        table.cell(dash, 0, row, "ST DURUM", text_color=color.white, bgcolor=label_bg, text_size=dash_text_size)
        table.cell(dash, 1, row, st_motor_state, text_color=color.white, bgcolor=st_motor_bg, text_size=dash_text_size)
        row += 1

        table.cell(dash, 0, row, "EMA DURUM", text_color=color.white, bgcolor=label_bg, text_size=dash_text_size)
        table.cell(dash, 1, row, ema_motor_state, text_color=color.white, bgcolor=ema_motor_bg, text_size=dash_text_size)
        row += 1

        table.cell(dash, 0, row, "AT-EMA DURUM", text_color=color.white, bgcolor=label_bg, text_size=dash_text_size)
        table.cell(dash, 1, row, atema_motor_state, text_color=color.white, bgcolor=atema_motor_bg, text_size=dash_text_size)
        row += 1

        table.cell(dash, 0, row, "GC-EMA DURUM", text_color=color.white, bgcolor=label_bg, text_size=dash_text_size)
        table.cell(dash, 1, row, gcema_motor_state, text_color=color.white, bgcolor=gcema_motor_bg, text_size=dash_text_size)
        row += 1

        table.cell(dash, 0, row, "ST-EMA DURUM", text_color=color.white, bgcolor=label_bg, text_size=dash_text_size)
        table.cell(dash, 1, row, stema_motor_state, text_color=color.white, bgcolor=stema_motor_bg, text_size=dash_text_size)
        row += 1

        table.cell(dash, 0, row, "AKTIF FILTRE", text_color=color.white, bgcolor=label_bg, text_size=dash_text_size)
        table.cell(dash, 1, row, str.tostring(active_filter_count), text_color=color.white, bgcolor=color.rgb(70, 70, 90), text_size=dash_text_size)
        row += 1

        if use_adx_filter
            adx_state = adx_filter_ok ? "ONAY / " + str.tostring(adx_value, format.mintick) : "ZAYIF / " + str.tostring(adx_value, format.mintick)
            adx_bg    = adx_filter_ok ? color.rgb(20, 115, 60) : color.rgb(160, 110, 20)
            table.cell(dash, 0, row, "ADX FILTRE", text_color=color.white, bgcolor=label_bg, text_size=dash_text_size)
            table.cell(dash, 1, row, adx_state, text_color=color.white, bgcolor=adx_bg, text_size=dash_text_size)
            row += 1

        table.cell(dash, 0, row, "KONFIG", text_color=color.white, bgcolor=label_bg, text_size=dash_text_size)
        table.cell(dash, 1, row, config_state, text_color=color.white, bgcolor=config_safe ? color.rgb(20, 115, 60) : color.rgb(180, 90, 20), text_size=dash_text_size)
        row += 1

        table.cell(dash, 0, row, "POZISYON", text_color=color.white, bgcolor=label_bg, text_size=dash_text_size)
        table.cell(dash, 1, row, position_state, text_color=color.white, bgcolor=in_long ? color.rgb(20,115,60) : in_short ? color.rgb(150,35,35) : color.rgb(70,70,70), text_size=dash_text_size)
        row += 1

        table.cell(dash, 0, row, "STATE DESYNC", text_color=color.white, bgcolor=label_bg, text_size=dash_text_size)
        table.cell(dash, 1, row, "IND: " + str.tostring(audit_state_desyncs), text_color=color.white, bgcolor=color.rgb(70, 70, 90), text_size=dash_text_size)
        row += 1

        table.cell(dash, 0, row, "STATE AUDIT", text_color=color.white, bgcolor=label_bg, text_size=dash_text_size)
        table.cell(dash, 1, row, state_audit_text, text_color=color.white, bgcolor=state_audit_bg, text_size=dash_text_size)
        row += 1

        table.cell(dash, 0, row, "CANLI UYARI", text_color=color.white, bgcolor=label_bg, text_size=dash_text_size)
        table.cell(dash, 1, row, live_alert_window_text, text_color=color.white, bgcolor=live_alert_window_bg, text_size=dash_text_size)
        row += 1

        table.cell(dash, 0, row, "RE-ENTRY LOCK", text_color=color.white, bgcolor=label_bg, text_size=dash_text_size)
        table.cell(dash, 1, row, reentry_state, text_color=color.white, bgcolor=(long_reentry_lock or short_reentry_lock) ? color.rgb(160, 110, 20) : color.rgb(70, 70, 70), text_size=dash_text_size)
        row += 1

        table.cell(dash, 0, row, "COOLDOWN", text_color=color.white, bgcolor=label_bg, text_size=dash_text_size)
        table.cell(dash, 1, row, cooldown_ok ? "YOK" : str.tostring(cooldown_left), text_color=color.white, bgcolor=cooldown_ok ? color.rgb(70, 70, 70) : color.rgb(150, 35, 35), text_size=dash_text_size)
        row += 1

        table.cell(dash, 0, row, "SON BLOK", text_color=color.white, bgcolor=label_bg, text_size=dash_text_size)
        table.cell(dash, 1, row, last_block_reason, text_color=color.white, bgcolor=block_bg(last_block_reason), text_size=dash_text_size)
        row += 1

        table.cell(dash, 0, row, "BU BAR DURUMU", text_color=color.white, bgcolor=label_bg, text_size=dash_text_size)
        table.cell(dash, 1, row, bar_status_now, text_color=color.white, bgcolor=bar_status_bg, text_size=dash_text_size)
        row += 1

        table.cell(dash, 0, row, "PARITY BAR", text_color=color.white, bgcolor=label_bg, text_size=dash_text_size)
        table.cell(dash, 1, row, parity_bar_text, text_color=color.white, bgcolor=parity_bar_bg, text_size=dash_text_size)
        row += 1

        table.cell(dash, 0, row, "PARITY ZINCIR", text_color=color.white, bgcolor=label_bg, text_size=dash_text_size)
        table.cell(dash, 1, row, audit_last_chain, text_color=color.white, bgcolor=audit_last_chain_bg, text_size=dash_text_size)
        row += 1

        table.cell(dash, 0, row, "PARITY NEDEN", text_color=color.white, bgcolor=label_bg, text_size=dash_text_size)
        table.cell(dash, 1, row, audit_last_reason, text_color=color.white, bgcolor=audit_last_reason_bg, text_size=dash_text_size)
        row += 1

        mix_count_text = "ER:" + str.tostring(audit_mix_ema_ok_regime_fail) + " RE:" + str.tostring(audit_mix_regime_ok_ema_fail) + " OP:" + str.tostring(audit_mix_opp_persist_wait) + " FF:" + str.tostring(audit_mix_ema_regime_fail)
        table.cell(dash, 0, row, "MIX SAYAC", text_color=color.white, bgcolor=label_bg, text_size=dash_text_size)
        table.cell(dash, 1, row, mix_count_text, text_color=color.white, bgcolor=(audit_mix_ema_ok_regime_fail + audit_mix_regime_ok_ema_fail + audit_mix_opp_persist_wait + audit_mix_ema_regime_fail) > 0 ? color.rgb(160, 110, 20) : color.rgb(70, 70, 70), text_size=dash_text_size)
        row += 1

        table.cell(dash, 0, row, "SON MIX", text_color=color.white, bgcolor=label_bg, text_size=dash_text_size)
        table.cell(dash, 1, row, last_mix_detail, text_color=color.white, bgcolor=mix_detail_bg(last_mix_detail), text_size=dash_text_size)
        row += 1

        table.cell(dash, 0, row, "SON CIKIS", text_color=color.white, bgcolor=label_bg, text_size=dash_text_size)
        table.cell(dash, 1, row, last_exit_reason, text_color=color.white, bgcolor=last_exit_bg, text_size=dash_text_size)
        row += 1

        entry_bg = last_entry_source == primary_entry_source_label ? color.rgb(20, 140, 95) : last_entry_source == "GERI_KAZANIM" ? color.rgb(60, 90, 160) : last_entry_source == "REJIM_DEVAM" ? color.rgb(20, 100, 120) : last_entry_source == "IKINCIL_DEVAM" ? color.rgb(50, 80, 140) : color.rgb(70, 70, 70)
        table.cell(dash, 0, row, "GIRIS KAYNAGI", text_color=color.white, bgcolor=label_bg, text_size=dash_text_size)
        table.cell(dash, 1, row, last_entry_source, text_color=color.white, bgcolor=entry_bg, text_size=dash_text_size)
        row += 1

        long_gate_text  = long_tp_wait_reset  ? "RESET BEKLE" : long_reentry_lock  and not na(long_reentry_level)  ? "ACIK > " + str.tostring(long_reentry_level,  format.mintick) : long_flip_reclaim_armed  and not na(last_long_exit_price)  ? engine_label + " > " + str.tostring(last_long_exit_price,  format.mintick) : "KAPALI"
        short_gate_text = short_tp_wait_reset ? "RESET BEKLE" : short_reentry_lock and not na(short_reentry_level) ? "ACIK < " + str.tostring(short_reentry_level, format.mintick) : short_flip_reclaim_armed and not na(last_short_exit_price) ? engine_label + " < " + str.tostring(last_short_exit_price, format.mintick) : "KAPALI"
        table.cell(dash, 0, row, "LONG YENI GIRIS", text_color=color.white, bgcolor=label_bg, text_size=dash_text_size)
        table.cell(dash, 1, row, long_gate_text, text_color=color.white, bgcolor=(long_reentry_lock or long_flip_reclaim_armed) ? color.rgb(40, 80, 140) : color.rgb(70, 70, 70), text_size=dash_text_size)
        row += 1

        table.cell(dash, 0, row, "SHORT YENI GIRIS", text_color=color.white, bgcolor=label_bg, text_size=dash_text_size)
        table.cell(dash, 1, row, short_gate_text, text_color=color.white, bgcolor=(short_reentry_lock or short_flip_reclaim_armed) ? color.rgb(40, 80, 140) : color.rgb(70, 70, 70), text_size=dash_text_size)
        row += 1

        table.cell(dash, 0, row, "KACAN REJIM", text_color=color.white, bgcolor=label_bg, text_size=dash_text_size)
        table.cell(dash, 1, row, str.tostring(audit_regime_blocks), text_color=color.white, bgcolor=color.rgb(160, 110, 20), text_size=dash_text_size)
        row += 1

        table.cell(dash, 0, row, "KACAN KALICILIK", text_color=color.white, bgcolor=label_bg, text_size=dash_text_size)
        table.cell(dash, 1, row, str.tostring(audit_regime_persist_blocks), text_color=color.white, bgcolor=color.rgb(180, 120, 30), text_size=dash_text_size)
        row += 1

        table.cell(dash, 0, row, "KACAN FILTRE", text_color=color.white, bgcolor=label_bg, text_size=dash_text_size)
        table.cell(dash, 1, row, str.tostring(audit_f